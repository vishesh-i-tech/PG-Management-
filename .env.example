# Supabase Public Configuration (Client & SSR)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Supabase Server-Only Secret (Service Role for Webhooks & Background Queues)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Razorpay Payment Gateway Credentials (Server-Side)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Internal Cron Security Secret (Vercel Cron <-> Route Handler)
CRON_SECRET="your-secure-cron-bearer-token"
